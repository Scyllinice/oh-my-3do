#!/usr/bin/env bash
# Run project commands in the 3DO SDK development container (Dockerfile at the
# repository root). The project is mounted at /workspace and files are created
# as the current user.
#
# Usage: tools/dev-container ACTION [ARGUMENTS...]
#   build                      build the container image (runs the tests)
#   test                       make test (the default)
#   menu | demo                build iso/boot.iso or iso/menu-demo.iso
#   cover GAME IMAGE           prepare a cover (prepare-cover.py)
#   covers                     export covers for the USB drive
#   resize-covers IN OUT       resize cover images
#   preview VIDEO OUTPUT       prepare a preview clip
#   media-index USB_ROOT       index a USB drive (index-media.py)
#   smoke                      the SDK's own smoke test
#   shell                      an interactive shell
#   run COMMAND ...            any command
# OH3DO_IMAGE picks another image; DEVKIT_REF the SDK revision for build.
set -euo pipefail

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
image=${OH3DO_IMAGE:-oh-my-3do-dev:local}
action=${1:-test}
if [[ $# -gt 0 ]]; then shift; fi

case "$action" in
    build)
        exec docker build --platform linux/amd64 \
            --build-arg "DEVKIT_REF=${DEVKIT_REF:-4e370299bd273bb13089d41fa33c5e863dc6d405}" \
            -t "$image" "$@" "$project_dir"
        ;;
    test) command_args=(make test "$@") ;;
    menu) command_args=(bash /workspace/tools/build-menu menu "$@") ;;
    demo) command_args=(bash /workspace/tools/build-menu demo "$@") ;;
    cover) command_args=(python3 /workspace/tools/prepare-cover.py "$@") ;;
    resize-covers) command_args=(python3 /workspace/tools/resize-covers.py "$@") ;;
    preview) command_args=(python3 /workspace/tools/prepare-preview.py "$@") ;;
    media-index) command_args=(python3 /workspace/tools/index-media.py "$@") ;;
    covers) command_args=(python3 /workspace/tools/export-covers.py "$@") ;;
    smoke) command_args=(devkit-smoke /workspace/build/devkit-smoke "$@") ;;
    shell) command_args=(bash --noprofile --norc "$@") ;;
    run)
        if [[ $# -eq 0 ]]; then
            echo 'Usage: tools/dev-container run COMMAND [ARGUMENTS...]' >&2
            exit 2
        fi
        command_args=("$@")
        ;;
    *)
        echo 'Usage: tools/dev-container {build|test|menu|demo|cover GAME IMAGE|covers|resize-covers INPUT OUTPUT|preview VIDEO OUTPUT|media-index USBROOT|smoke|shell|run COMMAND ...}' >&2
        exit 2
        ;;
esac

terminal_args=()
if [[ "$action" == shell && -t 0 && -t 1 ]]; then
    terminal_args=(-it)
fi

# Match host ownership for every generated artifact. No Docker socket or host
# devices are mounted inside the development container.
exec docker run --rm --init --platform linux/amd64 \
    --user "$(id -u):$(id -g)" \
    --mount "type=bind,source=$project_dir,target=/workspace" \
    --workdir /workspace \
    "${terminal_args[@]}" "$image" "${command_args[@]}"
