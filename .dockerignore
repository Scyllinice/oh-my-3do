# Keep the build context small; the SDK is downloaded inside the image.
**
!Dockerfile
!Makefile
!ohmy3do.ini
!docker/
!docker/**
!src/
!src/**
!vendor/
!vendor/**
!tests/
!tests/**
!tools/
!tools/prepare-runtime.py
!tools/index-media.py
!tools/prepare-preview.py
!tools/resize-covers.py

# Re-apply exclusions after the allowlist so generated test files stay out.
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.o
**/*.obj
**/*.log
**/*.tmp
**/.env*
